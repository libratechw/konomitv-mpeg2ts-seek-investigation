    },
    "target900": {
      "baselinePresentedMs": 191.1,
      "candidatePresentedMs": 238.9,
      "candidateMinusBaselineMs": 47.8,
      "rapSelected": false,
      "sameFirstFragmentMediaTime": true,
      "interpretation": "the coarse estimate started about 7.4 seconds early, the 4-8 MiB slice did not bracket the target, and the implementation fell back to the existing probes"
    }
  },
  "conclusion": {
    "scanner": "the linear PAT/PMT-aware MPEG-2 GOP scanner is technically viable",
    "seekPath": "fetching a multi-MiB RAP window on every seek adds more transfer latency than it removes in the measured path",
    "currentProbes": "the existing small timestamp probes already corrected the bitrate estimate and opened the target-containing fragment at both measured positions",
    "futureCondition": "reconsider RAP selection only when points are learned without an eager multi-MiB seek-time scan, for example from an opportunistic or persistent index, and when the index-owning interval is measured as dominant",
    "scope": "single runs at two targets establish rejection of this mechanism, not a population estimate for all recordings"
